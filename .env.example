# Copier ce fichier vers .env. Ne jamais committer .env.
# Aucun secret ne va dans l'application mobile : tout ce qui suit reste sur le serveur.

# Administrateur local. Laisser vide pour ne pas créer de compte admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Compte de démonstration, créé seulement hors production.
# Défauts si ces variables sont vides : demo@mijote.local / Mijote-Demo-2026!
# DEMO_EMAIL=demo@mijote.local
# DEMO_PASSWORD=Mijote-Demo-2026!

# Affiche le jeton de réinitialisation dans la réponse API.
# Interdit lorsque NODE_ENV=production. Ne jamais activer sur un serveur partagé.
PASSWORD_RESET_DEBUG=false

# PostgreSQL externe. Si vide, Mijoté utilise PostgreSQL embarqué (PGlite) dans data/pglite.
# DATABASE_URL=postgres://mijote:motdepasse@localhost:5432/mijote

# Assistant IA facultatif. La clé reste sur le serveur.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Courriel facultatif. Sans ces variables, aucun courriel n'est envoyé.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Mijoté <nepasrepondre@example.com>

# --- Connexion Google (serveur) ---
# Identifiants client OAuth acceptés comme audience du jeton Google, séparés par des virgules :
# le client « Application Web » et, au besoin, le client iOS. Format : xxxx.apps.googleusercontent.com
# Sans cette variable, « Continuer avec Google » indique qu'il n'est pas disponible.
# GOOGLE_CLIENT_IDS=

# --- Connexion par téléphone : Twilio Verify (serveur) ---
# Compte Twilio, jeton d'authentification et SID du service Verify (VA...).
# Le service Verify doit envoyer des codes de 6 chiffres. Sans ces variables, la connexion par SMS indique qu'elle n'est pas disponible.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Limites de la connexion par SMS (valeurs par défaut indiquées).
# AUTH_PHONE_RESEND_SECONDS=30
# AUTH_PHONE_SENDS_PER_HOUR=5
# AUTH_PHONE_SENDS_PER_HOUR_PER_IP=20
# AUTH_PHONE_CHECKS_PER_10_MIN=5
# AUTH_PHONE_CHECKS_PER_10_MIN_PER_IP=30
