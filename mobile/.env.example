# Copier ce fichier vers mobile/.env. Ne jamais committer mobile/.env.
# Variables EXPO_PUBLIC_* : visibles dans l'application. N'y mettre AUCUN secret.

# Adresse de l'API Mijoté (obligatoire en production, ex. https://api.example.com).
# En développement, l'adresse de l'ordinateur qui sert Expo est détectée automatiquement.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3001

# Google : identifiant du client OAuth « Application Web » (sert à obtenir le jeton d'identité).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# Google : identifiant du client OAuth iOS (facultatif sur Android).
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com

# Google, iOS uniquement, lu par app.config.js à la compilation :
# schéma d'URL inversé du client iOS (com.googleusercontent.apps.xxxx).
# GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.xxxx

# Démarrer en mode démonstration, sans serveur (données d'exemple).
# EXPO_PUBLIC_DATA_SOURCE=demo
